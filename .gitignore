# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/

# lighthouse
/.lighthouseci/

# design reference photos and previews (never commit)
/design/reference/
/design/previews/

# project screenshots: raw captures are regenerated by scripts/capture-project-screenshots.mjs
/design/project-images/raw/
# the owner's original image files are large and not shipped; only the WebP output in public/ is
/design/project-images/source/
